  .layout { flex-direction: column; }
  .sidebar { position: static; flex: none; width: 100%; height: auto;
             border-right: 0; border-bottom: 1px solid var(--border); }
  .content { padding: 1.4rem 1.2rem 4rem; }
}
`.trim();
}

// The page is static apart from three conveniences: a live filter, a theme
// toggle that remembers itself, and highlighting of the section being read.
const SCREEN_JS = `
const filter = document.getElementById('filter');
const count = document.getElementById('count');
const entries = [...document.querySelectorAll('[data-search]')];
const groups = [...document.querySelectorAll('section')];
const total = entries.length;

function applyFilter() {
  const query = filter.value.trim().toLowerCase();
  let shown = 0;
  for (const entry of entries) {
    const match = !query || entry.dataset.search.includes(query);
    entry.hidden = !match;
    if (match) shown++;
  }
  // Hide a section once everything inside it is filtered away.
  for (const group of groups.slice().reverse()) {
    group.hidden = group.querySelectorAll('[data-search]:not([hidden])').length === 0;
  }
  count.textContent = query
    ? shown + ' of ' + total + ' declarations'
    : total + ' declarations';
  for (const link of document.querySelectorAll('nav a')) {
    const section = document.getElementById(link.hash.slice(1))?.closest('section');
    link.hidden = !!(section && section.hidden);
  }
}
filter.addEventListener('input', applyFilter);
applyFilter();

document.addEventListener('keydown', (event) => {
  if (event.key === '/' && document.activeElement !== filter) {
    event.preventDefault();
    filter.focus();
  } else if (event.key === 'Escape' && document.activeElement === filter) {
    filter.value = '';
    applyFilter();
    filter.blur();
  }
});

const toggle = document.getElementById('theme');
const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
function setTheme(theme) {
  document.documentElement.dataset.theme = theme;
  toggle.textContent = theme === 'dark' ? '\\u2600' : '\\u263D';
  toggle.title = theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
}
setTheme(localStorage.getItem('verse-api-theme') || (systemDark.matches ? 'dark' : 'light'));
toggle.addEventListener('click', () => {
  const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  localStorage.setItem('verse-api-theme', next);
  setTheme(next);
});

const links = new Map([...document.querySelectorAll('nav a')].map(a => [a.hash.slice(1), a]));
const observer = new IntersectionObserver((records) => {
  for (const record of records) {
    if (!record.isIntersecting) continue;
    for (const link of links.values()) link.classList.remove('active');
    links.get(record.target.id)?.classList.add('active');
  }
}, { rootMargin: '0px 0px -80% 0px' });
for (const id of links.keys()) {
  const heading = document.getElementById(id);
  if (heading) observer.observe(heading);
}
`.trim();

function escapeHtml(text) {
  return text.replace(/[&<>"]/g,
    c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
}

// Inline Markdown, limited to what this document actually contains: `code`
// spans and *emphasis*. Code spans are separated out first so that an operator
// name such as `operator'*'` cannot be mistaken for the start of an emphasis
// run. Odd-numbered segments are the ones between backticks.
function inlineHtml(text) {
  return escapeHtml(text).split('`')
    .map((part, i) => i % 2 === 1
      ? `<code>${part}</code>`
      : part.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
             .replace(/\*([^*\s][^*]*?)\*/g, '<em>$1</em>'))
    .join('');
}

// One paragraph of documentation. Lines starting with "*" form a bullet list,
// as several doc comments enumerate cases that way; the rest are hard-wrapped
// pieces of one flow of prose.
function proseHtml(paragraph) {
  const out = [];
  let prose = [];
  let bullets = [];
  // The paragraph is reassembled before inline markup is applied, because a
  // hard-wrapped source line can split a `code span` or **emphasis** in two.
  const flushProse = () => {
    if (prose.length > 0) { out.push(`<p>${inlineHtml(prose.join(' '))}</p>`); prose = []; }
  };
  const flushBullets = () => {
    if (bullets.length > 0) { out.push(`<ul>${bullets.join('')}</ul>`); bullets = []; }
  };

  for (const line of paragraph.split('\n')) {
    const bullet = /^\s*\*\s+(.*)$/.exec(line);
    if (bullet) { flushProse(); bullets.push(`<li>${inlineHtml(bullet[1])}</li>`); continue; }
    // A blank line ends the paragraph, as it does in Markdown.
    if (line.trim() === '') { flushBullets(); flushProse(); continue; }
    flushBullets();
    prose.push(line.trim());
  }
  flushBullets();
  flushProse();
  return out.join('');
}

function badgesHtml(decl, parent) {
  const facts = declFactsWithin(decl, parent);
  if (facts.length === 0) return '';
  return `<div class="badges">` +
    facts.map(f => `<span class="badge ${f.kind}">${escapeHtml(f.label)}</span>`).join('') +
    `</div>`;
}

function sigHtml(signature) {
  return `<code class="sig">${highlightVerse(signature)}</code>`;
}

// Filtering matches on the signature, which is what a reader types when
// looking for a particular declaration.
function searchKey(text) {
  return escapeHtml(text.toLowerCase());
}

function entryHtml(decl, parent) {
  const { doc } = declParts(decl);
  const body = (doc ? proseHtml(doc) : '') + badgesHtml(decl, parent);
  return `<div class="entry" data-search="${searchKey(decl.signature)}">` +
         `<dt>${sigHtml(decl.signature)}</dt>` +
         (body ? `<dd>${body}</dd>` : '') + `</div>`;
}

// Runs of members that carry nothing but a signature are collapsed into one
// block that reads like the body of the type, rather than a stack of near-empty
// entries. Source order is kept by grouping consecutive members.
// Only members that add something of their own; the rest are already visible in
// the type's definition block.
function membersHtml(members, parent) {
  const documented = members.filter(m => hasSomethingToSay(m, parent));
  if (documented.length === 0) return '';
  return `<dl class="api">${documented.map(m => entryHtml(m, parent)).join('')}</dl>`;
}

// One element per line rather than a single <pre>, so that a signature too long
// for the column wraps with a hanging indent instead of being clipped or forcing
// the block to scroll sideways.
function definitionHtml(type) {
  const text = definitionText(type);
  const lines = text.split('\n').map(line => {
    const member = line.startsWith('    ');
    return `<code class="${member ? 'member' : 'head'}">` +
           `${highlightVerse(member ? line.slice(4) : line)}</code>`;
  });
  return `<div class="definition" data-search="${searchKey(text)}">${lines.join('')}</div>`;
}

function tableHtml(headers, rows, classes) {
  const head = headers.map(h => `<th>${inlineHtml(h)}</th>`).join('');
  const body = rows.map(row => {
    // The first column of every table here is a Verse signature, wrapped in
    // Markdown backticks by the shared row builders.
    const signature = row[0].replace(/^`|`$/g, '');
    const cells = row.map((cell, i) => {
      const cls = classes[i] ? ` class="${classes[i]}"` : '';
      return `<td${cls}>${i === 0 ? sigHtml(signature) : inlineHtml(cell)}</td>`;
    }).join('');
    return `<tr data-search="${searchKey(signature)}">${cells}</tr>`;
  }).join('');
  return `<table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
}

function slugger() {
  const seen = new Map();
  return (text) => {
    const base = text.replace(/`/g, '').toLowerCase()
      .replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'section';
    const count = (seen.get(base) ?? 0) + 1;
    seen.set(base, count);
    return count === 1 ? base : `${base}-${count}`;
  };
}

function renderHtml(model, opts) {
  const slug = slugger();
  const toc = [];
  const body = [];

  // Headings go into the sidebar down to level 3; level 4 is one entry per
  // native type, which would swamp it. Only a type declaration is Verse code
  // worth colouring; a category name such as `int` or a file name is not.
  const heading = (level, text, { verse = false, cls = '' } = {}) => {
    const id = slug(text);
    if (level === 2 || level === 3) toc.push({ level, text, id });
    const inner = verse ? sigHtml(text) : inlineHtml(text);
    const attr = cls ? ` class="${cls}"` : '';
    body.push(`<h${level} id="${id}"${attr}>${inner}` +
              `<a class="anchor" href="#${id}" aria-label="permalink">#</a></h${level}>`);
  };

  if (model.intrinsics.length > 0) {
    body.push('<section>');
    heading(2, 'Intrinsic functions');
    body.push(`<p class="intro">${INTRINSICS_INTRO.map(inlineHtml).join(' ')}</p>`);
    for (const [category, list] of categorise(model.intrinsics)) {
      body.push('<section>');
      heading(3, category);
      body.push('<dl class="api">' + list.map(intrinsic => {
        const signature = intrinsicSignature(intrinsic);
        const paragraphs = intrinsicBody(intrinsic).filter(p => p !== '');
        const rendered = paragraphs.map(p => /^\*.*\*$/.test(p)
          ? `<p class="notes">${inlineHtml(p.slice(1, -1))}</p>`
          : proseHtml(p)).join('');
        return `<div class="entry" data-search="${searchKey(signature)}">` +
               `<dt>${sigHtml(signature)}</dt>` +
               (rendered ? `<dd>${rendered}</dd>` : '') + `</div>`;
      }).join('') + '</dl>');
      body.push('</section>');
    }
    body.push('</section>');
  }

  for (const module of model.modules) {
    body.push('<section>');
    heading(2, `Module \`${module.path}\``);
    body.push(`<p class="intro">${inlineHtml(moduleSummary(module))}</p>`);

    for (const file of module.files) {
      body.push('<section>');
      heading(3, `\`${displayFileName(file.path)}\``);
      body.push(`<p class="filepath">${escapeHtml(file.path)}</p>`);

      const structure = fileStructure(file);
      if (structure.functions.length > 0) {
        body.push('<dl class="api">' +
                  structure.functions.map(d => entryHtml(d)).join('') + '</dl>');
      }
      for (const type of structure.types) {
        body.push('<section class="type">');
        heading(4, `\`${type.decl.qualifiedName}\``);
        const { doc } = declParts(type.decl);
        if (doc) body.push(proseHtml(doc));
        body.push(badgesHtml(type.decl));
        body.push(definitionHtml(type));
        body.push(membersHtml(type.members, type.decl));
        body.push('</section>');
      }
      body.push('</section>');
    }
    body.push('</section>');
  }

  if (opts.includeVerse) {
    const rows = appendixRows(model);
    if (rows.length > 0) {
      body.push('<section>');
      heading(2, APPENDIX_TITLE);
      body.push(`<p class="intro">${APPENDIX_INTRO.map(inlineHtml).join(' ')}</p>`);
      body.push(tableHtml(APPENDIX_TABLE_HEADERS, rows, ['', 'notes']));
      body.push('</section>');
    }
  }

  const nav = toc
    .map(e => {
      const label = e.text.replace(/`/g, '');
      return `<li><a class="l${e.level}" href="#${e.id}">${escapeHtml(label)}</a></li>`;
    })
    .join('');

  return `<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${escapeHtml(DOC_TITLE)}</title>
<style>
${screenCss()}
</style>
</head>
<body>
<div class="layout">
<aside class="sidebar">
  <h1>${escapeHtml(DOC_TITLE)}</h1>
  <p class="tagline">${escapeHtml(model.engineVersion || 'fortniteMain')}</p>
  <div class="controls">
    <input id="filter" type="search" placeholder="Filter declarations  (press /)"
           autocomplete="off" spellcheck="false">
    <button id="theme" type="button" title="Switch theme">&#9789;</button>
  </div>
  <p id="count"></p>
  <nav><ul>${nav}</ul></nav>
</aside>
<main class="content">
  <div class="note"><b>Generated file.</b>
  ${provenanceLines(model).map(inlineHtml).join(' ')}</div>
  <p class="intro">${DOC_INTRO.map(inlineHtml).join(' ')}</p>
  <p class="intro">${TYPE_INTRO.map(inlineHtml).join(' ')}</p>
${body.join('\n')}
</main>
</div>
<script>
${SCREEN_JS}
</script>
</body>
</html>
`;
}

// ---------------------------------------------------------------------------
// main
// ---------------------------------------------------------------------------

// A Verse module path looks like a Unix path, so Git Bash rewrites it on the
// way in: `--module /Verse.org/Verse` arrives as `C:/Program Files/Git/Verse.org/Verse`.
// Match what was asked for against what was found instead of trusting the text.
function resolveModuleArg(value, discovered) {
  if (discovered.has(value)) return value;
  const normalized = value.replace(/\\/g, '/');
  const match = [...discovered.keys()]
    .filter(known => normalized.endsWith(known) || normalized.endsWith(known.slice(1)))
    .sort((a, b) => b.length - a.length)[0];
  return match ?? value;
}

function engineVersion(engineRoot) {
  try {
    const version = JSON.parse(fs.readFileSync(path.join(engineRoot, 'Engine/Build/Build.version'), 'utf8'));
    const parts = [];
    if (version.MajorVersion !== undefined) {
      parts.push(`UE ${version.MajorVersion}.${version.MinorVersion}.${version.PatchVersion}`);
    }
    if (version.Changelist) parts.push(`CL ${version.Changelist}`);
    return parts.join(', ');
  } catch {
    return null;
  }
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const engineRoot = resolveEngineRoot(opts.engine);
  console.log(`Engine root: ${engineRoot}`);

  const model = {
    engineRoot,
    engineVersion: engineVersion(engineRoot),
    intrinsics: [],
    modules: [],
  };

  if (opts.intrinsics) {
    model.intrinsics = parseIntrinsics(engineRoot);
    console.log(`Intrinsics: ${model.intrinsics.length}`);
  }

  if (opts.natives) {
    const discovered = discoverModules(engineRoot, opts.roots, opts.includeTests);
    const wanted = opts.modules.includes('all')
      ? [...discovered.keys()].sort()
      : opts.modules.map(m => resolveModuleArg(m, discovered));

    for (const modulePath of wanted) {
      const module = discovered.get(modulePath);
      if (!module) {
        console.error(`Warning: module ${modulePath} not found under the scan roots. ` +
                      `Found: ${[...discovered.keys()].sort().join(', ') || 'none'}`);
        continue;
      }
      const files = [];
      for (const file of module.files) {
        const decls = collectSurface(parseVerseFile(file, modulePath, engineRoot), opts);
        if (decls.length === 0) continue;
        files.push({ path: path.relative(engineRoot, file).split(path.sep).join('/'), decls });
      }
      // A module can come out empty once access filtering has run, most often
      // a test suite whose contents are all internal. Leave it out entirely
      // rather than printing a heading with nothing under it.
      if (files.length === 0) continue;
      model.modules.push({ path: modulePath, files });
      const count = files.reduce((n, f) => n + f.decls.length, 0);
      console.log(`${modulePath}: ${count} declarations in ${files.length} files`);
    }
  }

  const report = file =>
    console.log(`Wrote ${path.relative(REPO_ROOT, file).split(path.sep).join('/')}`);

  // Topping up the worksheet is a job of its own: it describes the output
  // rather than producing it, so nothing else runs.
  if (opts.stubs) {
    const stubPath = path.resolve(REPO_ROOT, opts.stubs);
    const { added, kept, stale } = writeStubs(model, stubPath);
    const name = path.relative(REPO_ROOT, stubPath).split(path.sep).join('/');
    console.log(added > 0
      ? `${kept > 0 ? `Added ${added} new section(s) to` : `Wrote ${added} section(s) to`} ${name}`
      : `${name} already covers all ${kept} declarations; nothing added`);
    if (stale.length > 0) {
      console.error(`Warning: ${stale.length} existing section(s) no longer name exactly one ` +
                    `declaration and were left untouched: ${stale.join(', ')}`);
    }
    return;
  }

  const overridePath = path.resolve(REPO_ROOT, opts.overrides || DEFAULT_OVERRIDES);
  if (opts.useOverrides && fs.existsSync(overridePath)) {
    const applied = applyOverrides(model, parseOverrideFile(overridePath), opts.verbose);
    console.log(`Overrides: ${applied} applied from ` +
                `${path.relative(REPO_ROOT, overridePath).split(path.sep).join('/')}`);
  } else if (opts.overrides && opts.useOverrides) {
    console.error(`Error: overrides file not found: ${overridePath}`);
    process.exit(1);
  }

  const outPath = path.resolve(REPO_ROOT, opts.out || `build/verse_runtime_api.${opts.format}`);
  fs.mkdirSync(path.dirname(outPath), { recursive: true });

  const render = opts.format === 'html' ? renderHtml : renderMarkdown;
  fs.writeFileSync(outPath, render(model, opts), 'utf8');
  report(outPath);

  if (opts.json) {
    // The selector each declaration answers to, so that tooling built on the
    // JSON can address the overrides file without re-deriving them.
    const declarations = allDeclarations(model);
    for (const decl of declarations) decl.selector = uniqueSelector(decl, declarations);

    const jsonPath = path.resolve(REPO_ROOT, opts.json);
    fs.mkdirSync(path.dirname(jsonPath), { recursive: true });
    fs.writeFileSync(jsonPath, JSON.stringify(model, replacer, 2), 'utf8');
    console.log(`Wrote ${path.relative(REPO_ROOT, jsonPath).split(path.sep).join('/')}`);
  }

  if (warnings.length > 0) {
    console.log(`\n${warnings.length} thing(s) in the engine source did not parse` +
                (opts.verbose ? ':' : '; rerun with --verbose to list them.'));
    if (opts.verbose) for (const warning of warnings) console.log(`  ${warning}`);
  }
}

// `owner` back-references would make the model cyclic.
function replacer(key, value) {
  return key === 'owner' ? undefined : value;
}

main();
