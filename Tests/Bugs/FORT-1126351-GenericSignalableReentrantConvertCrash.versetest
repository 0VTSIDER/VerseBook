# Copyright Epic Games, Inc. All Rights Reserved.
#
# Tests for FORT-1126351: an in-the-wild instance of the FORT-1088027
# NullType convert crash, reached through Verse's generic `signalable(t)`
# boundary (the payload-erasure regression).
#
# Sequence of events on live: a minigame teleport-finish broadcasts a device event.
# Inside that outer transacted `event::Signal` broadcast, the map's generic
# `(S:signalable(t) where t:type).Signal(payload)` fires a typed player
# event. That inner Signal resumes a stranded awaiter, synchronously
# re-entering `task::Update` for the same task
# (`event::Signal -> task::ResumeAt -> task::Update`). The awaiter's payload
# slot was left in NULL state by a prior race self-completion (the
# FORT-1088027 producer), so coercing the any-boxed payload back to `player`
# reads a NullType value and faults at offset 0x8 (GetNumBytes on a null Type):
#
#   InitializeValueFrom<TObjectPtr<UObject>>   [DynamicallyTypedValue.h:65]
#   execConvertFromDynamicallyTypedValue       [VerseDynamicallyTypedValueLibrary.cpp:149]
#   ... task::Update -> task::ResumeAt -> event::Signal   (inner resume)
#   ..._impl__..signalable..Signal..payload    [VerseEvent.h:67]  <- the generic frame
#   ... FVerseEventCallbackList::Signal -> device_event::HandleGameplayEvent (outer broadcast)
#
# The producer: an arm of the `race` synchronously signals an event that
# completes another arm while the race is still spawning its arms. The race
# resolves re-entrantly, so its cancel pass runs before the remaining arms
# exist. Those arms then spawn into the already-resolved race and nothing ever
# cancels them; their event awaiters stay registered. On the next loop
# iteration the race reuses the same frame locals for its arm tasks, so when
# the stranded awaiter is finally signaled, it resumes a continuation that
# reads the payload through a local now pointing at the new iteration's
# (unset) awaiter — a NullType value.
#
# The fix (in the BPVM `race` codegen, `FCodeGenerator::EmitRace`): when the
# arm-spawning pass finishes and the race has already continued, the generated
# bytecode cancels the leftover late-spawned arms before suspending, which
# deregisters their event awaiters.

using { /Verse.org/Tests/VerseTestScriptCmd }

player := class:
	var Score:int = 0
	Do():void=
		set Score += 1

# The generic Signal: `t:type` erases `Value` to an `any` box, so the
# awaiter must coerce it back to `player` on resume. This adds the
# `signalable...Signal...payload` dispatch frame the field callstack shows.
(S:signalable(t) where t:type).SignalGeneric(Value:t):void=
	S.Signal(Value)

c1 := class:
	E0 : event() = event(){}
	E1 : event(player) = event(player){}
	E2 : event() = event(){}
	E3 : event() = event(){}
	var FirstIter : logic = true

	Listener()<suspends>:void =
		loop:
			E0.Await()
			race:
				E2.Await()
				block:
					if (FirstIter?):
						set FirstIter = false
						E2.Signal()
					E3.Await()
				E1.Await().Do()

assert:
	C := c1{}
	P := player{}
	spawn { C.Listener() }
	C.E0.Signal()
	C.E0.Signal()
	C.E1.SignalGeneric(P)   # generic (any-boxed) Signal -> resumes stranded E1 awaiter -> coerce any->player
	P.Score = 1
