# Copyright Epic Games, Inc. All Rights Reserved.
#
# Tests for FORT-1126351 (deferred-delivery variant). Companion to
# FORT-1126351-GenericSignalableReentrantConvertCrash.versetest, which has the
# full analysis; the root cause is shared with FORT-1088027.
#
# This test matches the crash issue in live structurally: the generic
# `signalable(t)` extension `SignalNextTick`, which defers the Signal by one
# tick (`spawn { WaitTicks(1); S.Signal(Value) }`) instead of firing it
# synchronously. The typed `event(player)` payload is still erased to an `any`
# box across the `t:type` boundary, and — before the fix — the awaiter was
# stranded in NULL state by the same-task race + synchronous self-completion
# (the FORT-1088027 producer). When the deferred Signal lands a tick later, the
# awaiter resumes and coerces the any-boxed payload back to `player`; on a
# stranded awaiter that read a NullType — either a check-failure, or hard 
# SIGSEGV, on BPVM.
#
# The fix (in the BPVM `race` codegen, `FCodeGenerator::EmitRace`): when the
# arm-spawning pass finishes and the race has already continued — only possible
# when it resolved re-entrantly mid-spawn — the generated bytecode cancels the
# leftover late-spawned arms before suspending. Cancelling them deregisters
# their event awaiters, so the deferred Signal a tick later only reaches the
# live awaiter of the current race iteration and the coercion succeeds.

using { /Verse.org/Tests/VerseTestScriptCmd }

player := class:
	var Score:int = 0
	Do():void=
		set Score += 1

# The generic deferred Signal: `t:type` erases `Value` to an `any` box,
# and delivery is deferred one tick via a spawned coroutine (the map's real
# `SignalNextTick` shape), rather than firing inline.
(S:signalable(t) where t:type).DelaySignal(Value:t)<suspends>:void=
	CoroUtils.WaitTicks(1)
	S.Signal(Value)

(S:signalable(t) where t:type).SignalNextTick(Value:t):void=
	spawn:
		S.DelaySignal(Value)

c1 := class:
	E0 : event() = event(){}
	E1 : event(player) = event(player){}   # typed event driven via SignalNextTick
	E2 : event() = event(){}
	E3 : event() = event(){}
	var FirstIter : logic = true

	Listener()<suspends>:void =
		loop:
			E0.Await()
			race:
				E2.Await()
				block:
					if (FirstIter?):
						set FirstIter = false
						E2.Signal()
					E3.Await()
				E1.Await().Do()

assert:
	C := c1{}
	P := player{}
	spawn { C.Listener() }
	C.E0.Signal()
	C.E0.Signal()
	C.E1.SignalNextTick(P)   # deferred generic (any-boxed) Signal -> resumes stranded E1 awaiter next tick
	CoroUtils.Tick(4)
	P.Score = 1
