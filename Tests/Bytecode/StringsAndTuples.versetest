# Bytecode shape of strings and tuples.
# See Bytecode.versetest for an explanation of `assert_bytecode` and the `# CHECK:` directive syntax.

using { /Verse.org/Tests/VerseTestScriptCmd }

# A string literal is a char-array constant moved into S; `.Length` uses the Length opcode just like
# arrays, and its result is compared.
assert_bytecode:
    # CHECK: [[S:r[0-9]+]] = Move(Source: c{{[0-9]+}}={{.*}}"hello")
    S := "hello"

    # CHECK: [[LEN:r[0-9]+]] = Length(Container: [[S]])
    # CHECK: [[CMP:r[0-9]+]] = Gt(LeftSource: [[LEN]], RightSource: c{{[0-9]+}}=0)
    S.Length > 0

# A tuple literal lowers to NewArray (moved into T); element access `T(0)` lowers to a `Call` on T,
# exactly like array indexing, whose result is compared.
assert_bytecode:
    # CHECK: [[NEW:r[0-9]+]] = NewArray(Values: (c{{[0-9]+}}=1, c{{[0-9]+}}=2, c{{[0-9]+}}=3))
    # CHECK: [[T:r[0-9]+]] = Move(Source: [[NEW]])
    T := (1, 2, 3)

    # CHECK: [[IDX:r[0-9]+]] = Call(Callee: [[T]], Arguments: (c{{[0-9]+}}=0){{.*}})
    # CHECK: [[CMP:r[0-9]+]] = Gt(LeftSource: [[IDX]], RightSource: c{{[0-9]+}}=0)
    T(0) > 0
