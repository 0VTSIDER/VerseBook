# Bytecode shape of map construction and lookup.
# See Bytecode.versetest for an explanation of `assert_bytecode` and the `# CHECK:` directive syntax.

using { /Verse.org/Tests/VerseTestScriptCmd }

# A map literal lowers to NewMap (separate Keys and Values tuples; string values are char arrays); its
# result is moved into M. Lookup `M[1]` lowers to a `Call` on M, whose result is moved into S. Finally
# `S = "a"` unifies S's value with the "a" constant - two Moves into the same comparison register.
assert_bytecode:
    # CHECK: [[NEW:r[0-9]+]] = NewMap(Keys: (c{{[0-9]+}}=1, c{{[0-9]+}}=2), Values:{{.*}}"a"{{.*}}"b"
    # CHECK: [[M:r[0-9]+]] = Move(Source: [[NEW]])
    M := map{1 => "a", 2 => "b"}

    # CHECK: [[LOOKUP:r[0-9]+]] = Call(Callee: [[M]], Arguments: (c{{[0-9]+}}=1){{.*}})
    # CHECK: [[S:r[0-9]+]] = Move(Source: [[LOOKUP]])
    S := M[1]

    # CHECK: [[EQ:r[0-9]+]] = Move(Source: [[S]])
    # CHECK: [[EQ]] = Move(Source: c{{[0-9]+}}={{.*}}"a")
    S = "a"
