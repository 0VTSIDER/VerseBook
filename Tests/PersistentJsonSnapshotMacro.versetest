# Tests for `assert_persistence_snapshot`. FORT-1079606.

using { /Verse.org/Tests/VerseTestScriptCmd }

assert_persistence_snapshot
{
    vpackage(P0, /A, ?Dependencies := ("Engine/VerseTestScriptCmd")):
        vmodule(SnapshotFlat):
            snippet:
                using { /Verse.org/Tests/VerseTestScriptCmd }

                snapshot_test_object := class<persistable><final><computes>:
                    Flag:logic
                    Count:int
                    Label:string
            snippet:
                Equal(Left:snapshot_test_object, Right:snapshot_test_object)<decides>:void =
                    Left.Flag = Right.Flag
                    Left.Count = Right.Count
                    Left.Label = Right.Label

    serialized:
        expected:snapshot_test_object = snapshot_test_object:
            Flag := true
            Count := 1
            Label := "flat"

    encodes:
        "\{\"$package_name\":\"/P0/_Verse\",\"$class_name\":\"SnapshotFlat-snapshot_test_object\",\"x_Flag\":true,\"x_Count\":1,\"x_Label\":\"flat\"\}"

    deserialized(UploadedAtFNVersion := 4200):
        "\{\"$package_name\":\"/SolIdeDataSources/_Verse\",\"$class_name\":\"snapshot_test_object\",\"x_Flag\":true,\"x_Count\":1,\"x_Label\":\"flat\"\}"
}

assert_persistence_snapshot
{
    vpackage(P1, /B, ?Dependencies := ("Engine/VerseTestScriptCmd")):
        vmodule(SnapshotMultiVersion):
            snippet:
                using { /Verse.org/Tests/VerseTestScriptCmd }

                multi_snapshot_test_object := class<persistable><final><computes>:
                    Flag:logic
                    Count:int
                    Label:string
            snippet:
                Equal(Left:multi_snapshot_test_object, Right:multi_snapshot_test_object)<decides>:void =
                    Left.Flag = Right.Flag
                    Left.Count = Right.Count
                    Left.Label = Right.Label

    serialized:
        expected:multi_snapshot_test_object = multi_snapshot_test_object:
            Flag := false
            Count := 42
            Label := "multi"

    deserialized(UploadedAtFNVersion := 4100):
        "\{\"$package_name\":\"/SolIdeDataSources/_Verse\",\"$class_name\":\"multi_snapshot_test_object\",\"x_Flag\":false,\"x_Count\":42,\"x_Label\":\"multi\"\}"

    deserialized(UploadedAtFNVersion := 4110):
        "\{\"$package_name\":\"/SolIdeDataSources/_Verse\",\"$class_name\":\"multi_snapshot_test_object\",\"x_Flag\":false,\"x_Count\":42,\"x_Label\":\"multi\"\}"

    deserialized(UploadedAtFNVersion := 4200):
        "\{\"$package_name\":\"/SolIdeDataSources/_Verse\",\"$class_name\":\"multi_snapshot_test_object\",\"x_Flag\":false,\"x_Count\":42,\"x_Label\":\"multi\"\}"
}

# No Equal anywhere in this block. A persistable class is not `comparable` (Script Error 3509), so
# the re-encoded JSON compare is the whole check here. The blocks above add an Equal on top of it.
assert_persistence_snapshot
{
    vpackage(P4, /E, ?Dependencies := ("Engine/VerseTestScriptCmd")):
        vmodule(SnapshotNoEqual):
            snippet:
                using { /Verse.org/Tests/VerseTestScriptCmd }

                no_equal_inner := class<persistable><final><computes>:
                    Name:string

                no_equal_test_object := class<persistable><final><computes>:
                    Flag:logic
                    Count:int
                    Label:string
                    Inner:no_equal_inner

    serialized:
        expected:no_equal_test_object = no_equal_test_object:
            Flag := true
            Count := 7
            Label := "no-equal"
            Inner := no_equal_inner:
                Name := "nested"

    encodes:
        "\{\"$package_name\":\"/P4/_Verse\",\"$class_name\":\"SnapshotNoEqual-no_equal_test_object\",\"x_Flag\":true,\"x_Count\":7,\"x_Label\":\"no-equal\",\"x_Inner\":\{\"$package_name\":\"/P4/_Verse\",\"$class_name\":\"SnapshotNoEqual-no_equal_inner\",\"x_Name\":\"nested\"\}\}"

    deserialized(UploadedAtFNVersion := 4300):
        "\{\"$package_name\":\"/P4/_Verse\",\"$class_name\":\"SnapshotNoEqual-no_equal_test_object\",\"x_Flag\":true,\"x_Count\":7,\"x_Label\":\"no-equal\",\"x_Inner\":\{\"$package_name\":\"/P4/_Verse\",\"$class_name\":\"SnapshotNoEqual-no_equal_inner\",\"x_Name\":\"nested\"\}\}"
}

