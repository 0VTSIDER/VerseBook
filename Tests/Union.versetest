        case (Y):
            union1.X() =>
            union1.X( V : tuple() ) => # Unreachable

vu := union{ V : void}

assert:
    Foo():logic=
        case(vu.V()):
            vu.V() => return true
    Foo() = true

tvu := union{ X : tuple()}

assert:
    Main():logic =
        case (tvu.X()):
            tvu.X() => return true
    Main() = true

assert:
    Main():logic=
        case (tvu.X(())):
            tvu.X() => return true
    Main() = true

# A case over an <open> union without a default clause might fail (open unions can grow).
assert_semantic_error(3512):
    u := union<open>{ A : int, B : int }
    Foo(U : u):void=
        case(U):
            u.A(X : int) =>
            u.B(X : int) =>

# A case over an <open> union with a default clause is ok.
assert_valid:
    u := union<open>{ A : int, B : int }
    Foo(U : u):void=
        case(U):
            u.A(X : int) =>
            u.B(X : int) =>
            _ =>

# A case over a <closed> (default) union covering all variants is exhaustive.
assert_valid:
    u := union{ A : int, B : int }
    Foo(U : u):void=
        case(U):
            u.A(X : int) =>
            u.B(X : int) =>

# A case over an <open> union in a <decides> context is ok without a default (the case may fail).
assert_valid:
    u := union<open>{ A : int, B : int }
    Foo(U : u)<decides>:void=
        case(U):
            u.A(X : int) =>
            u.B(X : int) =>

fcu := union{Number : int}

assert:
    Expected : fcu = fcu.Number(6)
    Main(FCU: fcu):logic=
        Actual := fcu.Number
        case(Actual(6)):
            fcu.Number(6) => return true
            fcu.Number( Number : int) => return false

    Main(Expected) = true

assert:
    Expected : fcu = fcu.Number(7)
    Main(FCU: fcu):logic=
        Actual := fcu.Number
        case(Actual(7)):
            fcu.Number(5) => return false
            fcu.Number(6) => return false
            fcu.Number( Number : int) => return true

    Main(Expected) = true

assert:
    Main():logic=
        FCU1 := fcu.Number
        FCU2 := fcu.Number
        return logic{FCU1(1) = FCU2(2)}
    Main() = false

# Can pattern match against first class variants when payload is not a type binding
assert_valid:
    fcu := union{Number : int}

    Main(FCU: fcu):logic=
        Actual := fcu.Number
        case(Actual(6)):
            fcu.Number(5) => return false
            fcu.Number(6) => return true
            fcu.Number( Number : int) => return false

# Variant constructors are not supported in pattern matching (expects 'int->fcu', gets 'fcu')
assert_semantic_error(3618):
    fcu := union{Number : int}

    Main(FCU: fcu):logic=
        Actual := fcu.Number
        case(Actual):
            fcu.Number(5) => return false
            fcu.Number(6) => return true
            fcu.Number( Number : int) => return false

# Duplicate payload if a first class variant and regular variant have same payload
assert_semantic_error(3616):
    fcu := union{Number : int}

    Main(FCU: fcu):logic=
        Actual := fcu.Number
        case(Actual(6)):
            fcu.Number(6) => return false
            fcu.Number(6) => return true
            fcu.Number(Number : int) => return false

# First class union variant constructor must take in a bound value payload
assert_semantic_error(3509):
    fcu := union{Number : int}
    Foo():void=
        FCU := fcu.Number(Num : int)
        Result:comparable = FCU(5)

assert_semantic_error(3509):
    fcu := union{Number : int}
    Foo():void=
        FCU := fcu.Number(Num : int)
        case(FCU):
            _=>

# Join supported for first class variants of the same unions
assert_valid:
    fcu0 := union{Number : int}
    Foo():void=
        F0 := fcu0.Number
        F1 := fcu0.Number
        FCU := if(false?). F0 else. F1

        case(FCU(5)):
            fcu0.Number(Num : int) =>

# Join supported for first class variants from different unions in case blocks
assert_valid:
    fcu0 := union{Number : int}
    fcu1 := union{Number : int}
    Foo():void=
        F := fcu0.Number
        G := fcu1.Number
        FCU := if(false?). fcu0.Number else. fcu1.Number
        FCU(5)

# Join supported for first class variants of the same unions
assert_valid:
    fcu0 := union{Number : int}
    Func(Number : int):void=
        0

    Foo():void=
        F := fcu0.Number
        FCU := if(false?). Func else. F 

        FCU(5) 

assert_valid:
    fcu0 := union{Number : int}
    
    Foo(NumVariant : type{_(:int):fcu0}):void=
        F := fcu0.Number
        FCU := if(false?). NumVariant else. F

        FCU(5)

fcu0 := union{Number : int}
fcu1 := union{Number : int}

assert:
    Expected : fcu1 = fcu1.Number(5)
    Foo():logic=
        F := fcu0.Number
        G := fcu1.Number
        FCU := if(false?). F else. G
        return logic{FCU(5) = Expected}
        
    Foo() = true

assert_valid:
    fcu0 := union{Number : int}

    Foo(NumVariant : type{_(:int)<converges>:fcu0}):logic=
        Expected : fcu0 = fcu0.Number(5)
        F := fcu0.Number
        FCU := if(false?). NumVariant else. F

        return logic{FCU(5) = Expected}

assert:
    Expected : fcu0 = fcu0.Number(5)
    
    F := fcu0.Number
    G := fcu0.Number
    FCU := if(false?). G else. F

    var Result : logic = false
    case(FCU(5)):
        fcu0.Number(4) =>
        fcu0.Number(Num : int) => set Result = true

    Result = true

# Attempting to use a union variant constructor to implicitly construct a new union variant variable is not yet supported
assert_semantic_error(3547):
    union1 := union:
        X:int
    F:type{_(:int)<converges><closed>:union1} = union1.X
    Y := F(1) 

assert_semantic_error(3509):
    union1 := union:
        X:int
    Y: union1 = 1

# Attempting to set a union variant equal to its payload type value is not supported
assert_semantic_error(3512):
    union1 := union:
        X:int
    F:type{_(:int)<closed><computes>:union1} = union1.X
    Y:F = 1


} # Verse VM Only