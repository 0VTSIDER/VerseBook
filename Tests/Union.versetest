        u := union{N:int}

    b := module:
        u := union{U : a.u}

# protected is only allowed on class constructors and inside classes/interfaces — not on union names
assert_semantic_error(3594) { u<protected> := union{N:int}}

# Access specifier in the macro-effect position (mirrors interface / class behaviour)
assert_valid                { u := union<public>{N:int}}
assert_valid                { u := union<internal>{N:int}}
assert_semantic_error(3594) { u<public> := union<protected>{N:int}}
assert_semantic_error(3594) { u<public> := union<private>{N:int}}

# Conflicting access specifiers in the macro-effect position
assert_semantic_error(3543) { u := union<public><internal>{N:int}}

# Effect attribute and access specifier combine cleanly
assert_valid                { u<public> := union<computes>{N:int}}
assert_valid                { u<public> := union<converges>{N:int}}

# Variants cannot carry their own access specifier - visibility is inherited from the union
assert_semantic_error(3604) { u := union{N<public>:int}}
assert_semantic_error(3604) { u := union{N<private>:int}}
assert_semantic_error(3604) { u := union{N<internal>:int}}

