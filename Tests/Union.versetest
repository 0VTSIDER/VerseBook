# Nested case with union variants
assert_valid:
    u := union{ U : u, S : string, V : void}

    F(LU:u):void=
        case(LU):
            u.U(_U : u)=>
                case(_U):
                    u.U(__U:u)=>
                    _=>
            _=>

nu0 := union{ NU : nu1, S : string, V : void}
nu1 := union{ NU : nu0, N : int, F : float}

assert:
    F(NU:nu0):int=
        case(NU):
            nu0.NU(NU1 : nu1)=>
                case(NU1):
                    nu1.NU(NU0 : nu0)=>
                        case(NU0):
                            nu0.V()=> 42
                            _=> 0
                    nu1.N(N : int)=> N
                    _=> 0
            _=> 0

    F(nu0.NU(nu1.NU(nu0.V()))) = 42

assert:
    F(NU:nu0):int=
        case(NU):
            nu0.NU(NU1 : nu1)=>
                case(NU1):
                    nu1.NU(NU0 : nu0)=>
                        case(NU0):
                            nu0.V()=> 42
                            _=> 0
                    nu1.N(5) =>
                        5
                    nu1.N(N : int)=> N
                    _=> 0
            _=> 0

    F(nu0.NU(nu1.N(67))) = 67

