using { /Verse.org/Native }
using {/Verse.org/Tests/VerseTestScriptCmd}
using { /Verse.org/Concurrency }

# Make sure union macro is not supported in the BPVM
bp_vm_only
{
# Macro 'union' does not exist in BPVM
assert_semantic_error(3506){U := union{}}
}



verse_vm_only
{
# Macro "union" does not require EpicInternal user scope
assert_valid { vpackage(P,/NotVerse.org,?Scope:=PublicUser) { snippet { U := union{N:int} } } }

assert_semantic_error(3619) { u:=union{}}
assert_valid { u:=union{U:u}}
assert_semantic_error(3547) { u:=union{V : void}; U:=u.V()} # Unions can't be implicitly defined
assert_semantic_error(3547) { e:=enum{A}; E:=e.A} # Enums also can't implicitly be defined
assert_valid { U:=union{V : void}}
assert_valid { U:=union{T : tuple(int, int)}}
assert_valid { U:=union{N0 : int, N1 : int}}
assert_valid { U:=union<open>{N0 : int, N1 : string, V : void}}
assert_valid { U:=union<closed>{N : int, S : string, V : void}}
assert_semantic_error(3604) { U:=union<open><closed>{N : int, S : string, V : void}}
assert_valid { U:=union{N:int}; UM: [U]int = map{}}
assert_semantic_error(3628, 3628) {u:=union{ A : void, A : int, A : string}}
assert_semantic_error(3628, 3628) {u:=union{ V : void, V : void, V : void}}
assert_semantic_error(3502) {union1 := union{ N:int = 0} } # Union variants can't have default values

assert_valid{u := union{V:void}; MyArray:[]u = array{}}
assert_valid{u := union{V:void}; MyArray:[]u = array{u.V()}}
assert_semantic_error(3509){u0 := union{V:void}; u1 := union{V:void}; MyArray:[]u0 = array{u1.V()}}

# Test that you can't define two union types with the same name.
assert_semantic_error(3532){ u:=union{a:void}; u:=union{b:void} }

# Test that you can't use the union macro except as the direct RHS of a definition.
assert_semantic_error(3560){ union{Empty : void} }
assert_semantic_error(3606){ C:=-union{Empty : void} }
assert_semantic_error(3606,3547){ C:=union{Empty : void}+1 }
assert_semantic_error(3502){ f():void= union{Empty : void} }
assert_semantic_error(3502){ f():void={union{Empty : void}}}
assert_semantic_error(3547){ u := union{Empty : void}; U := u.Empty() }

# Test that you can't define a local union type.
assert_semantic_error(3502){ f():void={ u:=union{V : void} } }

# Malformed variant definition
assert_semantic_error(3540){ u := union{ : int}}
assert_semantic_error(3546){ u := union{ Empty }}
assert_semantic_error(3546){ u := union{ Empty() : void }}
assert_semantic_error(3547){ u := union{ Empty : void() }}

assert_valid:
    NoDupeUnionValues := union:
        V : void
        N : int

    NoDupeUnionValues2 := union:
        V : void
        N : int

assert_semantic_error(3628):
    DuplicateVariants := union:
        S : string
        S : string

assert_semantic_error(3532):
    DuplicateVariantIdentifiers := union:
        S : string

    DuplicateVariantIdentifiers := union:
        S : string

assert_valid:
    S:string=""
    SomeUnion := union:
        (SomeUnion:)S : string
        V : void
        N : int

assert_valid:
    u := union{V:void}
    c := class:
        U : u = u.V()
        UO : ?u = false
        UM : [u]int = map{ u.V() => 0}
        UMV : [int]u = map{ 0 => u.V()}    
        UA : []u = array{}

# Cannot compare a comparable vs. noncomparable 
assert_semantic_error(3509, 3512):
    some_class := class{}
    u := union {N : int, C : some_class }
    l : logic = logic{u.C(some_class{}) = u.N(42)} 

inttree := union:
    Empty : void
    Leaf : int
    Node : node    

node := struct<computes>:
    Left : inttree
    Value : int
    Right : inttree

Sum(T: inttree) : int = {
  case (T) {
    inttree.Node(N : node) =>
        N.Value + Sum(N.Left) + Sum(N.Right)
    inttree.Leaf(Number : int) =>
        Number
    inttree.Empty() => 0
  }
}

IntTreeLeaf : inttree = inttree.Leaf(1)
DeadEndNode : node = node{Left:=IntTreeLeaf, Value:=2, Right:=IntTreeLeaf}
IntTreeDeadEnd : inttree = inttree.Node(DeadEndNode)
IntTreeNode : node = node{Left:=IntTreeLeaf, Value:=2, Right:=IntTreeDeadEnd}
IntTree : inttree = inttree.Node(IntTreeNode)

assert:
    Sum(IntTree) = 7

# You can use a union as its own a payload type
assert_valid:
    u := union{ U : u, V : void}

ru := union{ U : ru, V : void}

assert_valid:
    ru := union{ U : ru, V : void}
    U : ru = ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.V()))))))))))))))))))))))))

assert_semantic_error(3509):
    ru := union{ U : ru, V : void}
    U : ru = ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.V))))))))))))))))))))))))

# Void variant payload case is resolved properly
assert:
    U : ru = ru.V()
    Foo(_U:ru):int=
        case(_U):
            ru.U(LU : ru) => Foo(_U) + 1
            ru.V() => 0
    Foo(U) = 0

# finite recursion
assert:
    U : ru = ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.U(ru.V()))))))))))))))))))))))))
    Foo(_U:ru):int=
        case(_U):
            ru.U(LU : ru) => Foo(LU) + 1
            ru.V() => 0
    Foo(U) = 24
   
u := union {N0:int, N1:int, V:void}

assert:
    FlipFlop(U:u):u=
        case(U):
            u.N0(X:int)=> u.N1(X)
            u.N1(X:int)=> u.N0(X)
            _=> u.V()

    FlipFlop(u.N0(6)) = u.N1(6)

# Wildcard with max payload causes error
assert_semantic_error(2302):
    u := union {A:int, B:int, C:void}

    FlipFlop(U:u):u=
        case(U):
            u.A(X:int)=> u.B(X)
            u.B(X:int)=> u.A(X)
            u.C() => u.C()
            _=> u.C() #Invalid wildcard - we hit max already

# Not handling all values
assert_semantic_error(3512):
    u := union {N0:int, N1:int, V:void}
    FlipFlop(U:u):u=
        case(U):
            u.N0(X:int)=> u.N1(X)
            u.N1(X:int)=> u.N0(X)

# Can't case over a union that is not owned by the LHS
assert_semantic_error(3618):
    u1 := union {AN:int}
    u2 := union {BN:int}
    Foo(U:u1):void=
        case(U):
            u2.BN(X:int)=>

# You can't have a function as a union in a case
assert_semantic_error(3617, 3618):
    u1 := union {N:int}
    f0():void={}
    U1 : u1 = u1.N(1)
    f1():void=
        case(U1):
            f0() =>
            _=>    

u1 := union:
    N:int
    S : string
    V : void
    
u2 := union:
    N:int
    S : string
    V : void

assert{u1.N(1) = u1.N(1)}
assert{u1.N(1) <> u1.N(2)}

# Maps
U1Map : [u1]int = map {u1.N(67) => 0, u1.V() => 1}

assert:
    U1Int := U1Map[u1.N(67)] or Err()
    U1Int = 0

assert:
    U1Int := U1Map[u1.V()] or Err()
    U1Int = 1

assert:
    var SomeUnionMap : [u1]int = map{}
    set SomeUnionMap[u1.S("Fizz")] = 6
    SomeUnionMap[u1.S("Fizz")] = 6
    logic{SomeUnionMap[u1.S("Buzz")]} = false

assert:
    var SomeUnionMap : [int]u1 = map{}
    set SomeUnionMap[0] = u1.N(6)
    SomeUnionMap[0] = u1.N(6)
    SomeUnionMap[0] <> u1.N(7)

assert_valid:
    u1 := union:
        N:int
        S : string
        V : void
    Foo():void=
        SomeUnion := u1.S

assert_valid:
    u1 := union:
        N:int
        S : string
        V : void
    Foo():void=
        SomeUnion := u1.S

# First class variants can't be defined in module scope regardless of a type being specified
assert_semantic_error(3547):
    u1 := union:
        N:int
        S : string
        V : void

    SomeUnion := u1.S
    Foo():void=
        SomeUnion("Hello")

# First class variants CAN be defined in module scope if a type is specified
assert_valid:
    u1 := union:
        N:int
        S : string
        V : void

    SomeUnion : type{_(:string)<closed>:u1} = u1.S

# First class functions also can't be defined in module/global scope
assert_valid:
    Foo():int=
        0
    Main():void=
        MyF := Foo

assert_semantic_error(3547):
    Foo():int=
        0
    MyF := Foo

assert:
    logic{U1Map[u1.S("Buzz")]} = false

assert:
    U1 : u1 = u1.N(1)
    U2 : u2 = u2.N(1)
    U1 <> U2

assert:
    U1 : u1 = u1.N(1)
    U2 : u2 = u2.N(1)
    not U1 = U2
    

assert:
    V1 : u1 = u1.N(1)
    V2 : u1 = u1.N(1)
    V1 = V2

GU1() : u1 = u1.V()
IsV(PU1 : u1) : logic =
    case(PU1):
        u1.V() => true
        u1.S(S : string) => false
        _=> false

assert:
    IsV(GU1()) = true

assert:
    IsV(u1.S("Fizz")) = false

assert:
    GU1() = u1.V()

assert:
    var U1 : u1 = u1.S("Fizz")
    U1 = u1.S("Fizz")

assert:
    var U1 : u1 = u1.V()
    U1 = u1.V()
    set U1 = u1.S("Fizz")
    U1 = u1.S("Fizz")

GU1_ : u1 = u1.V()

assert{GU1_ = u1.V()}

# Join
assert_valid:
    u := union{N:int}
    U1 : u = u.N(0)
    U2 : u = u.N(1)
    UA : []u = array{U1, U2}

# Invalid join
assert_semantic_error(3509):
    u1 := union{N:int}
    u2 := union{N:int}

    U1 : u1 = u1.N(0)
    U2 : u2 = u2.N(1)
    UA : []u1 = array{U1, U2}

# Bound variant payloads in case block
assert_valid:
    u := union{N:int, V:void, C:void}
    U : u = u.N(5)
    Foo():void=
        case(U):
            u.N(1) => 0
            u.N(2) => 1
            _=> 3

# Mixing bound payloads with unbound payloads 
assert_valid:
    u := union{ N : int, V : void, S : string }

    Fun(U:u):void=
        case(U):
            u.N(2)=>
            u.S(String : string)=>
            _=>

assert_valid:
    u := union{ N : int, V : void, S : string }

    Fun(U:u):void=
        case(U):
            u.N(2)=>
            u.N(Number:int)=>
            _=>

assert_semantic_error(3512):
    u := union{ N : int, V : void, S : string }

    Fun(U:u):void=
        case(U):
            u.N(2)=>
            u.N(Number:int)=>

assert_valid:
    u := union{ N : int, V : void, S : string }

    Fun(U:u)<decides>:void=
        case(U):
            u.N(2)=>
            u.N(Number:int)=>

assert_valid:
    u := union{ N : int, V : void, S : string }

    Fun(U:u):void=
        case(U):
            u.S(String : string)=>
            u.N(2)=>
            _=>

assert_valid:
    u := union{ N : int, V : void, S : string }
    Num : int = 4
    Fun(U:u):void=
        case(U):
            u.N(Num)=>
            u.S(String : string)=>
            _=>

# Expect union variant as initializer 
assert_semantic_error(3509):
    u0:=union{V : void}
    c0 := class:
        var M0:u0=u0 # invalid

# Non-invocation variant in case is not supported
assert_semantic_error(3620):
    u := union{ P : void }
    U : u = u.P()

    Fun():void=
        case(U):
            u.P => # Invalid, expected P()

# Duplicate wildcards in non-exhaustive case
assert_semantic_error(3616):
    u := union{ P : void, Number : int }
    U : u = u.P()

    Fun():void=
        case(U):
            u.P() =>
            _=>
            _=> # Double wildcard

# Unnecessary wildcard in exhaustive case
assert_semantic_error(2302):
    u := union{ P : void }
    U : u = u.P()

    Fun():void=
        case(U):
            u.P() =>
            _=>

# Missing arm
assert_semantic_error(3620):
    u := union{ P : void }
    U : u = u.P()

    Fun():void=
        case(U):
            u.P() 
            _=>

# Misplaced literal
assert_semantic_error(3620):
    u := union{ P : void }
    U : u = u.P()

    Fun():void=
        case(U):
            67
            u.P() => 
            _=>
    
# We don't support parametric unions yet
assert_semantic_error(3502){node(t:type) := class{}; PU(t: type) := union{ P : node(t) }}

# Persistable unions
assert_valid:
    u:=union<persistable><final>{V:void}
    persist_class := class<persistable><final>:
        ValidUnion : u = u.V()

# Can't have non-persistable members in a union
assert_semantic_error(3662):
    non_persistable_class := class:
        Number : int = 4

    u:=union<persistable><final>{V:void, C : non_persistable_class}
    persist_class := class<persistable><final>:
        ValidUnion : u = u.V()

# Can't have non-persistable members in a nested union
assert_semantic_error(3662):
    non_persistable_class := class:
        Number : int = 4

    nu:=union<persistable><final>{C : non_persistable_class}
    u:=union<persistable><final>{V:void, NestedUnion : nu}
    persist_class := class<persistable><final>:
        ValidUnion : u = u.V()

# You can't use an enum in a union case
assert_semantic_error(3620, 3618):
    e:=enum{A,B,C}
    u:=union{V : void}
    Fun(U:u):void=
        case(U):
            e.A =>
            _=>

assert_semantic_error(3509):
    u:=union{P:void}
    c0 := class:
        var M0:u=u.P()
    f0():void=
        C0:= c0{}
        set C0.M0=u

assert_valid:
    u := union { P : int, V : void}
    U1 : u = u.P(1)
    U2 : u = u.V()
    A :[]any = array{U1, U2}
    
assert_valid:
    u := union { P : int}
    A : any = u.P(1)
    F0(:u):int=0
    F1(:u):int=1
    Fs : [](u->int) = array{F0, F1}

assert_valid:
    u := union { P : int}
    F0(:u):int = 0
    F1(:u):int = 1
    Fs : [](false->int) = array{F0, F1}
    
F0(X:any):any=X
UF:=union{N:int}
assert{F0(UF)}
assert{F0(UF.N(6))}

assert{option{UF.N(0)}?}
UF2: UF =UF.N(0)
assert{option{UF.N(0)}? = UF2}

assert_valid:
    u := union {P : int}
    U : comparable = u.P(6)

Equal(X:t, Y:comparable where t:subtype(comparable))<computes><decides>:t =
    X = Y

assert:
    logic{Equal[UF.N(1), UF.N(1)]} = true

assert:
    logic{Equal[UF.N(0), UF.N(1)]} = false

variant_types := union:
    String : string
    Int : int
    Logic : logic
    Other : void

VariantTypesAsString(VariantTypes : variant_types):string=
    case(VariantTypes):
        variant_types.String(String : string) => String
        variant_types.Int(Number : int) => DebugToString(Number)
        variant_types.Logic(Logic : logic) => if(Logic?){"true"}else{"false"}
        _=> "Nothing"

# Test for duplicate variants causing a compiler error
assert_semantic_error(3616):
    variant_types := union:
        String : string
        Int : int
        Logic : logic
        Other : void

    VariantTypesAsStringCompileError(VariantTypes : variant_types):string=
        case(VariantTypes):
            variant_types.String(String : string) => String
            variant_types.Int(Int : int) => "Number"
            variant_types.Int(Number : int) => "NUMBER"
            variant_types.Logic(Logic : logic) => if(Logic?){"true"}else{"false"}
            _=> "Nothing"
assert:
    VariantTypesAsString(variant_types.String("TripleT")) = "TripleT"
    VariantTypesAsString(variant_types.Logic(true)) = "true"
    VariantTypesAsString(variant_types.Int(67)) = "67"
    VariantTypesAsString(variant_types.Other()) = "Nothing"
    
assert_semantic_error(3509):
    c(t:type) := class{X : int = 1}
    U0 := union{Event : c(int)}
    ExpressionCheck(X : U0):void=
        case(U0.Event(c(int))):
            U0.Event(_ : c(int)) => 

u1_ := union{U2:u2_, V:void}
u2_ := union{U3:u3_}
u3_ := union{V:void}

UF0(U:u1_):logic=
    case(U):
        u1_.U2(U2 : u2_) => true
        _=> false

assert:
    UF0(u1_.U2(u2_.U3(u3_.V()))) = true

assert:
    UF0(u1_.V()) <> true

assert:
    MU := u1_.U2(u2_.U3(u3_.V()))
    logic{Equal[u1_.U2(u2_.U3(u3_.V())), MU]} = true

assert:
    MU := u1.N(1)
    logic{Equal[MU, 1]} = false

assert:
    MU := u1.N(1)
    var Success : logic = false
    case(MU):
        u1.N(1) => set Success = true
        _=> set Success = false
    Success = true

s := struct<computes>{ N : int }
assert:
    MU := u1.N(1)
    logic{Equal[MU, s{N:=1}]} = false

assert:
    MU := u1_.U2(u2_.U3(u3_.V()))
    logic{Equal[MU, s{N:=1}]} = false

us := union{ S0 : string, S1 : string}
assert:
    MU : us = us.S0("buzz")
    not Equal[MU, "buzz"]
    logic{Equal[MU, us.S1("buzz")]} = false

e := enum{A, B}
ue := union{A : void, B : void}
assert:
    UE : ue = ue.A()
    logic{Equal[UE, e.A]} = false

assert:
    MU := u1_.U2(u2_.U3(u3_.V()))
    logic{Equal[MU, e.B]} = false

assert_valid:
    u := union{V : void, S : string} 
    Foo(U:u)<decides>:void=
        case(U):
            u.V() =>

# This is legal just like the next test that has an enum
assert_valid:
    u := union{V : void, S : string} 
    Foo(U:u)<decides>:void=
        case(U):
            u.V() =>
            u.S(S : string) =>

assert_valid:
    u := union{V : void, S : string}
    Foo(U:u):void=
        logic{
        case(U):
            u.V() =>
        }

# Fully exhausted variant case is decides, since case guarantees each variant
assert_valid:
    u := union{V : void, S : string}
    Foo(U:u):void=
        logic{
        case(U):
            u.V() =>
            u.S("String") =>    
        }

# Bound variant payloads are supported
assert_valid:
    u := union{V : void, S : string}
    Foo(U:u):void=
        case(U):
            u.V()                =>
            u.S("String")        =>
            u.S(String : string) =>

# Bound payloads should not be able to exist after its pertaining type binding variant
assert_valid:
    u := union{V : void, S : string}
    Foo(U:u):void=
        case(U):
            u.V()                =>
            u.S(String : string) => # Type binding variant
            u.S("String")        => # Unreachable bound payload

assert_valid:
    u := union{V : void, S : string}
    Foo(U:u):void=
        logic{
        case(U):
            u.S("Hello") =>
            u.S(S : string) =>
        }

assert_valid:
    u := union{V : void, S : string}
    Foo(U:u):void=
        case(U):
            u.S("Hello") =>
            u.S(S : string) =>
            u.V() =>

assert_valid:
    u := union{V : void, S : string}
    Foo(U:u)<decides>:void=
        case(U):
            u.S("Hello") =>
            u.V() =>

assert_valid:
    u := union{V : void, SN : tuple(string, int)}
    Foo(U:u):void=
        case(U):
            u.SN("Hello", 6) =>
            u.SN("Hello", Number : int) =>
            u.SN(StringNumber : tuple(string, int)) =>
            u.V() =>

# Payload type validation
assert_semantic_error(3509):
    u := union{N : int}
    U : u = u.N("string")

assert_semantic_error(3509):
    u := union{N : int}
    U : u = u.N(String : string)

assert_semantic_error(3509):
    u := union{N : int}
    U : u = u.N(Number : int)

# Mismatch of payload is not allowed
assert_semantic_error(3509):
    u := union{V : void}
    Foo(U:u):void=
        case(U):
            u.V(Logic : logic) =>

# The pattern's payload type must be a subtype of the variant's payload type
# expected int, got tuple(int, int)
assert_semantic_error(3509):
    u := union{N : int, V : void}
    Foo(U:u):void=
        case(U):
            u.N(A : int, B : int) =>
            _=>

# Mixed value + binding with the wrong shape is the same error
assert_semantic_error(3509):
    u := union{N : int, V : void}
    Foo(U:u):void=
        case(U):
            u.N(1, B : int) =>
            _=>

# expected tuple(string, int), got tuple(string, int, logic)
assert_semantic_error(3509):
    u := union{SN : tuple(string, int), V : void}
    Foo(U:u):void=
        case(U):
            u.SN(A : string, B : int, C : logic) =>
            _=>

# Right arity, wrong element type - diagnostic points at the element
assert_semantic_error(3509):
    u := union{SN : tuple(string, int), V : void}
    Foo(U:u):void=
        case(U):
            u.SN(S : string, L : logic) =>
            _=>

# A binding that shadows an existing definition is an error; known siblings are still checked
assert_semantic_error(3532, 3509):
    u := union{SN : tuple(string, int), V : void}
    X : string = "collide"
    Foo(U:u):void=
        case(U):
            u.SN(X : string, L : logic) =>
            _=>

tu := union{SN : tuple(string, int), N : int}

assert:
    var Passed : logic = false
    case(tu.N(7)):
        tu.N(6) => 
        tu.N(Numb : int) => set Passed = true
    Passed = true

# Runtime pattern matching tuple as separate parameters
assert:
    var Passed : logic = false
    case(tu.SN("string", 7)):
        tu.SN("Hello", 6) =>
        tu.SN(String : string, Number : int) => set Passed = true # Should match here
        tu.N(Numb : int) => 
    Passed = true

# Runtime pattern matching tuple as tuple
assert:
    var Passed : logic = false
    case(tu.SN("string", 7)):
        tu.N(Numb : int) =>
        tu.SN("Hello", 6) =>
        tu.SN("Hello", Number : int) =>
        tu.SN(Tup : tuple(string, int)) => set Passed = true # Should match here
    Passed = true

# Runtime pattern matching fully bound tuple
assert:
    var Passed : logic = false
    case(tu.SN("Hello", 6)):
        tu.N(Numb : int) =>
        tu.SN("Hello", 6) =>  set Passed = true
        tu.SN("Hello", Number : int) =>
        tu.SN(String : string, Number : int) =>
    Passed = true

# Runtime pattern matching partially bound tuple
assert:
    var Passed : logic = false
    case(tu.SN("Hello", 7)):
        tu.N(Numb : int) =>
        tu.SN("Hello", 6) =>
        tu.SN("Hello", Number : int) => set Passed = true
        tu.SN(String : string, Number : int) =>
    Passed = true

# A mixed arm in last position still discriminates on its value elements
assert:
    logic{
        case(tu.SN("Bye", 6)):
            tu.SN("Hello", Number : int) => 0
    } = false

assert:
    logic{
        case(tu.SN("Hello", 6)):
            tu.SN("Hello", Number : int) => 0
    } = true

# A mixed last arm never exhausts, so a non-decides case still needs a wildcard
assert_semantic_error(3512):
    u := union{SN : tuple(string, int), N : int}
    Foo(U:u):void=
        case(U):
            u.N(Numb : int) =>
            u.SN("Hello", Number : int) =>

# Destructured bindings receive their tuple element, not the whole payload
assert:
    var Res : int = 0
    case(tu.SN("Hello", 7)):
        tu.N(Numb : int) => set Res = Numb
        tu.SN(S : string, Number : int) => set Res = Number
    Res = 7

assert:
    var Res : string = ""
    case(tu.SN("Hello", 7)):
        tu.N(Numb : int) =>
        tu.SN(S : string, Number : int) => set Res = S
    Res = "Hello"

# Mixed-arm bindings also read their element
assert:
    var Res : int = 0
    case(tu.SN("Hello", 7)):
        tu.SN("Hello", Number : int) => set Res = Number
        _ => set Res = 1
    Res = 7

# Whole-tuple bindings still receive the whole payload
assert:
    var Res : int = 0
    case(tu.SN("Hello", 7)):
        tu.SN(Tup : tuple(string, int)) => set Res = Tup(1)
        _ =>
    Res = 7

# A non-matching destructured arm must not disturb other arms (element reads stay guarded)
assert:
    var Res : int = 0
    case(tu.N(7)):
        tu.SN(S : string, Number : int) => set Res = Number
        tu.N(Numb : int) => set Res = Numb
    Res = 7

# A pattern binding that shadows an existing definition is an error, consistent with parameter shadowing
assert_semantic_error(3532):
    u := union{SN : tuple(string, int), N : int}
    X : string = "outer"
    Foo(U:u):void=
        case(U):
            u.SN(X : string, Number : int) =>
            _ =>

# Each arm binds its own name: the idiomatic same-name-per-arm pattern works on every path
assert:
    F(U:tu):tu=
        case(U):
            tu.N(X : int) => tu.N(X + 1)
            tu.SN(S : string, X : int) => tu.SN(S, X + 2)
    F(tu.N(5)) = tu.N(6)

assert:
    F(U:tu):tu=
        case(U):
            tu.N(X : int) => tu.N(X + 1)
            tu.SN(S : string, X : int) => tu.SN(S, X + 2)
    F(tu.SN("Hello", 5)) = tu.SN("Hello", 7)

# Cross-arm same name with different payload types
assert:
    F(U:u1):string=
        case(U):
            u1.N(X : int) => "int"
            u1.S(X : string) => X
            _ => "other"
    F(u1.S("hi")) = "hi"

# Duplicate binding name within one arm is an error
assert_semantic_error(3532):
    u := union{SN : tuple(string, int), N : int}
    Foo(U:u):void=
        case(U):
            u.SN(X : string, X : int) =>
            _ =>

# Bind-and-match: X := 9 binds the payload and constrains it to 9
assert:
    var Res : int = 0
    case(tu.N(9)):
        tu.N(X := 9) => set Res = X
        _ => set Res = 1
    Res = 9

# A non-matching value falls through to the next arm
assert:
    var Res : int = 0
    case(tu.N(5)):
        tu.N(X := 9) => set Res = X
        tu.N(Numb : int) => set Res = Numb + 10
    Res = 15

# Bind-and-match does not exhaust its variant, so the later arms are reachable
assert_valid:
    u := union{N : int, V : void}
    Foo(U:u):void=
        case(U):
            u.N(X := 9) =>
            u.N(Numb : int) =>
            _ =>

# Typed bind-and-match destructure: the value constrains, the sibling still binds
assert:
    var Res : string = ""
    case(tu.SN("Hello", 7)):
        tu.SN(S : string = "Bye", Number : int) => set Res = "wrong"
        tu.SN(S : string = "Hello", Number : int) => set Res = S
        _ =>
    Res = "Hello"

# Bind-and-match in last position under a failure context uses the noteq guard
assert:
    logic{
        case(tu.N(5)):
            tu.N(X := 9) => 0
    } = false

# A mixed arm only covers payloads matching its value elements, so a later
# value arm of the same variant with different elements is still reachable
assert:
    var Passed : logic = false
    case(tu.SN("Bye", 6)):
        tu.SN("Hello", Number : int) =>
        tu.SN("Bye", 6) => set Passed = true
        tu.N(Numb : int) =>
        tu.SN(Rest : tuple(string, int)) =>
    Passed = true

# A value arm after a full-binding arm of the same variant is unreachable
assert_semantic_error(3616):
    u := union{V : void, S : string, N : int}
    Foo(U:u):void=
        case(U):
            u.S(String : string) =>
            u.S("Hello") =>
            _=>

# Can't have a case variant that defines as tuple and without both parameters
assert_semantic_error(3616):
    tu := union{N : int, SN : tuple(string, int)}

    Foo():void=
        case(tu.SN("Hello", 6)):
            tu.N(Numb : int) =>
            tu.SN("Hello", 6) => 
            tu.SN("Hello", Number : int) =>
            tu.SN(Tup : tuple(string, int)) =>
            tu.SN(String : string, Number : int) =>

# tuple's are treated as 2 parameters
assert_valid:
    u := union{V : void, SN : tuple(string, int)}
    Foo(U:u):void=
        case(U):
            u.SN("Hello", 6) =>
            u.SN("Hello", Number : int) =>
            u.SN(String : string, Number : int) =>
            u.V() =>

# Payload in case domain must match variants defined payload
