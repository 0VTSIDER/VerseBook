# Comparing structs in pattern matching (including nested structs)
cst := struct<computes>:
    Number : int
    String : string
    Logic : logic

st := struct<computes>:
    Number : int
    String : string
    Logic : logic
    CompStruct : cst

stu := union:
    OuterStruct : st
    InnerStruct : cst

assert:
    InnerStruct : cst = cst{Number := 6, String := "Fizz", Logic := false}
    OuterStruct : st = st{Number := 7, String := "Buzz", Logic := false, CompStruct := InnerStruct}
    StructUnion : stu = stu.OuterStruct(OuterStruct)
    Foo():logic=
        case(StructUnion):
            stu.InnerStruct(Inner : cst) =>
            stu.OuterStruct(st{Number := 7, String := "Buzz", Logic := false, CompStruct := InnerStruct}) => return true
            stu.OuterStruct(Outer : st) =>
        return false
    Foo() = true

assert:
    InnerStruct : cst = cst{Number := 6, String := "Fizz", Logic := false}
    OuterStruct : st = st{Number := 7, String := "Buzz", Logic := false, CompStruct := InnerStruct}
    StructUnion : stu = stu.OuterStruct(OuterStruct)
    Foo():logic=
        case(StructUnion):
            stu.InnerStruct(Inner : cst) =>
            stu.OuterStruct(st{Number := 7, String := "Buzz", Logic := true, CompStruct := InnerStruct}) =>
            stu.OuterStruct(Outer : st) => return true
        return false
    Foo() = true

